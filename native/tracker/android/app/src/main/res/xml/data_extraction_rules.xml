<?xml version="1.0" encoding="utf-8"?>
<!-- Audit F-018: the device key lives in SharedPreferences (tracker_native). Nothing
     of this app goes to cloud backup or device-to-device transfer; after a restore
     the owner pastes the key once in Settings. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
