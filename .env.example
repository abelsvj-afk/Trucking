# See docs/runtime.md for what each of these is used for and by what.
# Copy this file to .env.local (or your deployment platform's env config)
# and fill in real values there. Never commit real values.

# Supabase — docs/architecture.md, docs/design/security.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security entirely — full access to every
# table. NOT used by the industry-intelligence job (docs/automation.md
# requires that job's credential be scoped to industry_briefings only,
# least-privilege — see INDUSTRY_BRIEFING_DB_* below). Reserved for
# migrations/admin tooling only; nothing in the app itself should import
# this at request time.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. The industry-intelligence scheduled job's own scoped
# credential (docs/automation.md task 4.4) — a dedicated Postgres role
# that can write industry_briefings and nothing else, verified unable to
# touch any other table. Not the service-role key above.
INDUSTRY_BRIEFING_DB_URL=

# AI — docs/design/ai-architecture.md. Server-only.
OPENAI_API_KEY=
# Optional. Defaults to a conservative fallback in code
# (services/ai/providers/openai.ts) if unset - set this explicitly to
# whatever OpenAI's docs currently list, since model names change quickly
# and the default was not verified against a live API call from this
# sandbox (network egress blocked to platform.openai.com).
OPENAI_MODEL=
# Reserved for a future Anthropic provider implementation behind the same
# services/ai interface (docs/design/ai-architecture.md) — not used yet.
ANTHROPIC_API_KEY=

# Industry intelligence scheduled job's fuel-market source — EIA Open Data
# API (free), docs/design/ai-architecture.md. Server-only.
# FREE KEY REGISTRATION (owner setup item): the key itself is free at
# https://www.eia.gov/opendata/ - without it, the industry-intelligence
# briefing has no fuel source, and the Deep Research Engine's diesel
# watcher skips gracefully (visible on the Research page) and infers
# fuel pressure from news only.
EIA_API_KEY=

# Smart Path truck routing — docs/design/driver-mvp.md §8.5. Server-only.
# OpenRouteService `driving-hgv` (truck-legal routing) — the API key is
# FREE (Standard plan, 2,000 directions/day) from openrouteservice.org.
# Optional but recommended: with it set, OpenRouteService is the primary
# router; without it the chain falls back to keyless Valhalla truck
# costing, then to the OSRM car profile (labeled NOT truck-checked).
# On Fly this is a secret: fly secrets set ORS_API_KEY=<key> -a trucking
ORS_API_KEY=
# Optional. Full URL of the Valhalla route endpoint used as the keyless
# truck-routing fallback. Defaults to the public OpenStreetMap endpoint
# (https://valhalla1.openstreetmap.de/route); point it at a self-hosted
# Valhalla instance later without a code change.
VALHALLA_URL=

# Deep Research Engine (docs/design/research-engine.md) — all optional,
# every value has a conservative default in services/research/config.ts.
# Server-only.
# RESEARCH_BASELINE_INTERVAL_DAYS=15   # baseline briefing cadence (twice-monthly)
# RESEARCH_DIESEL_THRESHOLD_PCT=3      # |week-over-week diesel move| that counts as pressure
# RESEARCH_MAX_RUNS_PER_DAY=2          # hard caps - enforced from the run log, never memory
# RESEARCH_MAX_RUNS_PER_MONTH=10
# RESEARCH_NEWS_BURST_MIN_ITEMS=4      # same-topic items inside the window that count as a burst
# RESEARCH_NEWS_BURST_WINDOW_HOURS=48
# Industry intelligence scheduled job — docs/automation.md, docs/runtime.md.
# Server-only. Authenticates the OPTIONAL manual-trigger debug route
# (docs/runtime.md) — not required for scheduling itself, which runs
# in-process with no external caller to authenticate.
INDUSTRY_BRIEFING_CRON_SECRET=

# Telegram private bot — docs/design/driver-mvp.md §4. Server-only, all
# optional: with TELEGRAM_BOT_TOKEN unset the webhook route is disabled.
# The bot serves ONE private chat (the owner's) and nothing else.
# Create the bot via @BotFather; never commit the real token.
TELEGRAM_BOT_TOKEN=
# The owner's Telegram chat id. Learned via the bot's bootstrap reply
# (message the bot before setting this), then set so the bot serves
# only that chat.
TELEGRAM_ALLOWED_CHAT_ID=
# A random string the owner generates; sent by Telegram as the
# x-telegram-bot-api-secret-token header on every webhook call (pass
# the same value as secret_token when registering the webhook).
TELEGRAM_WEBHOOK_SECRET=
# Optional. The owner's company uuid (user_profiles.company_id). Only
# used so the bot can store dispatch exchanges against his tenant —
# a deliberate, documented exception to the service-role note above:
# the write is scoped to this one env-provided company id, never to
# user-supplied input (docs/design/driver-mvp.md §5). Unset = the bot
# still replies, it just doesn't store exchanges.
TELEGRAM_COMPANY_ID=
